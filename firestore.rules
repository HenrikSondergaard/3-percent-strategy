rules_version = '2';

// SPX options viewer — Firestore security rules.
//
// Read is restricted to signed-in team members (Firebase Authentication). The website
// gates the whole UI behind a login; this rule enforces it at the data layer too, so the
// data can't be read straight from the API with the public web config.
//
// All writes come from ibkr_to_firebase.py via the Firebase Admin SDK, which uses a
// service account and bypasses these rules entirely. So we lock writes to "false".
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
