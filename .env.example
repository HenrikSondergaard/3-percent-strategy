# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml (IB Gateway).
# Use your LIVE IBKR credentials — real-time OPRA data is on the live account.

TWS_USERID=your_ib_username
TWS_PASSWORD=your_ib_password
TRADING_MODE=live

# Safety: block order placement over the API (we only read market data).
READ_ONLY_API=yes

# Restart nightly so the session refreshes; with 2FA you re-approve ~weekly.
AUTO_RESTART_TIME=11:59 PM
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes
TIME_ZONE=Europe/Stockholm
BYPASS_WARNING=yes

# Set a password to reach the gateway GUI over VNC (127.0.0.1:5900) for first login.
VNC_SERVER_PASSWORD=
