# Copy to ibkr-fetcher.env (git-ignored) and fill in. Read by ibkr-fetcher.service.
# NOTE: systemd EnvironmentFile does NOT support inline comments (VALUE  # ...).
# Keep comments on their own lines and values clean, e.g. IBKR_WEEKS=1

# Firebase service-account JSON on the server (NEVER commit this file).
GOOGLE_APPLICATION_CREDENTIALS=/home/you/secrets/serviceAccount.json

# Gateway connection (matches docker-compose.yml). 4001 = live, 4002 = paper.
IB_HOST=127.0.0.1
IB_PORT=4001
IB_CLIENT_ID=7

# Underlying.
IBKR_SYMBOL=SPX

# How many upcoming weekly expirations to cover.
IBKR_WEEKS=1

# Strike half-window around spot, in index points (OTM leg only, ~5-pt grid).
IBKR_BAND_POINTS=300

# Hard cap on simultaneous market-data lines (free tier = 100).
IBKR_MAX_LINES=90

# Seconds between Firestore writes (300 = 5 min).
PUBLISH_INTERVAL=300

# Only needed if the SPX index isn't real-time on your account (no index sub):
# a rough current SPX level to bootstrap strike selection. Parity self-corrects after.
IBKR_SPOT_HINT=7465

# Set to 1 to publish even when the US market is closed (useful for testing).
# IGNORE_MARKET_HOURS=1
