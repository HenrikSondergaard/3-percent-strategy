rules_version = '2';

// SPX options viewer — Firestore security rules.
//
// The website needs only public read access. All writes come from
// tradier_to_firebase.py via the Firebase Admin SDK, which uses a service
// account and bypasses these rules entirely. So we lock writes to "false".
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
